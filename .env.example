OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM-as-judge 전용 모델 (생성 모델과 다른 모델로 직접 지정, 현재 운영값은 gpt-6.1-terra)
OPENAI_JUDGE_MODEL=
INTERNAL_SHARED_SECRET=
MAX_CONTEST_IMAGE_BYTES=10000000
MAX_PORTFOLIO_PDF_BYTES=20000000
PORTFOLIO_PDF_MAX_PAGES=15
# 생성 텍스트 판정 비율(0~1). 기본 0.2(표본 감사), 1이면 전수 판정.
JUDGE_SAMPLE_RATE=0.2
# /docs·/openapi.json 노출. 운영에서는 false, 로컬 개발에서만 true.
API_DOCS_ENABLED=false
# 생성 모델 추론 강도(none/minimal/low/medium/high/xhigh/max 중 하나). 비우면 모델 기본값.
OPENAI_REASONING_EFFORT=
# Supabase 튜닝 설정값 캐시 시간(초).
CONFIG_CACHE_SECONDS=60
# 모니터링 텔레메트리 전용 Supabase 프로젝트 (도메인 데이터는 저장하지 않음). service_role 키 사용.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=