OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM-as-judge 전용 모델 (생성 모델과 분리, GPT-5 이상급 권장)
OPENAI_JUDGE_MODEL=
INTERNAL_SHARED_SECRET=
MAX_CONTEST_IMAGE_BYTES=10000000
MAX_PORTFOLIO_PDF_BYTES=20000000
PORTFOLIO_PDF_MAX_PAGES=15
# 모니터링 텔레메트리 전용 Supabase 프로젝트 (도메인 데이터는 저장하지 않음). service_role 키 사용.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=